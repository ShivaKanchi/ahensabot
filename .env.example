# nanobot Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# ===========================

# OpenRouter (Recommended - supports Claude, GPT, Qwen, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
NANOBOT_MODEL=openrouter/anthropic/claude-opus-4-5

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Qwen (Alibaba)
# Get your key at: https://dashscope.console.aliyun.com
QWEN_API_KEY=your-api-key-here

# DeepSeek
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-api-key-here

# Moonshot/Kimi
# Get your key at: https://platform.moonshot.cn
MOONSHOT_API_KEY=your-api-key-here

# Local LLM (vLLM)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=dummy

# ===========================
# Chat Channel Configuration
# ===========================

# Telegram Bot
# Create bot with @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Discord Bot
# Create at: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Slack Bot
# Create at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here

# DingTalk
# Create at: https://open.dingtalk.com
DINGTALK_CLIENT_ID=your-client-id-here
DINGTALK_CLIENT_SECRET=your-client-secret-here

# Feishu (Lark)
# Create at: https://open.feishu.cn
FEISHU_BOT_TOKEN=your-bot-token-here

# Email Configuration (for email channel)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# QQ Bot
# Create at: QQ Developer Platform
QQ_BOT_TOKEN=your-qq-bot-token-here

# WhatsApp (requires WhatsApp Business API)
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your-whatsapp-token-here
